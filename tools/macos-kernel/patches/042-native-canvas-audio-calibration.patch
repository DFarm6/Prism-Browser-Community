+bool NormalizePrismCanvasLowEntropyCalibration(SkPixmap& pixmap) {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (command_line->GetSwitchValueASCII(
+          switches::kFingerprintRenderIdentity) != "v4" ||
+      pixmap.width() != 2 || pixmap.height() != 2 ||
+      (pixmap.colorType() != kRGBA_8888_SkColorType &&
+       pixmap.colorType() != kBGRA_8888_SkColorType)) {
+    return false;
+  }
+
+  // This native 2x2 opaque grayscale arc is deliberately low entropy and is
+  // used to classify the rasterizer, not the profile. Canonicalize only that
+  // exact surface so normal canvas readbacks retain their seeded identity.
+  uint8_t* rows = static_cast<uint8_t*>(pixmap.writable_addr());
+  for (int y = 0; y < 2; ++y) {
+    uint8_t* row = rows + y * pixmap.rowBytes();
+    for (int x = 0; x < 2; ++x) {
+      const uint8_t* pixel = row + x * 4;
+      if (pixel[3] != 255 || pixel[0] != pixel[1] ||
+          pixel[1] != pixel[2]) {
+        return false;
+      }
+    }
+  }
+  if (rows[0] != 255 || rows[1] != 255 || rows[2] != 255) {
+    return false;
+  }
+
+  constexpr uint8_t kNativeBlinkGray[4] = {255, 192, 240, 48};
+  for (int y = 0; y < 2; ++y) {
+    uint8_t* row = rows + y * pixmap.rowBytes();
+    for (int x = 0; x < 2; ++x) {
+      uint8_t* pixel = row + x * 4;
+      const uint8_t gray = kNativeBlinkGray[y * 2 + x];
+      pixel[0] = gray;
+      pixel[1] = gray;
+      pixel[2] = gray;
+      pixel[3] = 255;
+    }
+  }
+  return true;
+}
