+    return {"Microsoft Haruka", "Microsoft Ayumi", "Microsoft Ichiro"};
+  }
+  if (primary == "fr") {
+    return {"Microsoft Denise", "Microsoft Henri", "Microsoft Hortense"};
+  }
+  if (primary == "zh") {
+    return {"Microsoft Huihui", "Microsoft Kangkang", "Microsoft Yaoyao"};
+  }
+  return {"Microsoft Aria", "Microsoft Guy", "Microsoft Zira"};
+}
