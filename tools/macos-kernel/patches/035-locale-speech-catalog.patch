+
+std::string PrismVoiceLanguage() {
+  std::string language =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          switches::kFingerprintLanguage);
+  if (language.empty()) {
+    language = "en-US";
+  }
+  for (char& character : language) {
+    if (character == '_') {
+      character = '-';
+    }
+  }
+  return language;
+}
+
+std::array<const char*, 3> PrismVoiceNames(
