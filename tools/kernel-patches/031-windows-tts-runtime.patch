+// Local replacements for the Windows SDK sphelper functions keep WRL token
+// ownership explicit and match current Chromium's native SAPI path.
+HRESULT PrismSpEnumTokens(const WCHAR* category_id,
+                          const WCHAR* required_attributes,
+                          const WCHAR* optional_attributes,
+                          IEnumSpObjectTokens** out_tokens) {
+  Microsoft::WRL::ComPtr<ISpObjectTokenCategory> category;
+  HRESULT result = ::CoCreateInstance(CLSID_SpObjectTokenCategory, nullptr,
+                                      CLSCTX_ALL, IID_PPV_ARGS(&category));
+  if (SUCCEEDED(result))
+    result = category->SetId(category_id, FALSE);
+  if (SUCCEEDED(result)) {
+    result = category->EnumTokens(required_attributes, optional_attributes,
+                                  out_tokens);
+  }
+  return result;
+}
+
+HRESULT PrismSpGetDescription(ISpObjectToken* token, PWSTR* description) {
+  LANGID language_id = ::GetUserDefaultUILanguage();
+  std::wstring language_hex =
+      base::ASCIIToWide(base::StringPrintf("%04X", language_id));
+  HRESULT result = token->GetStringValue(language_hex.c_str(), description);
+  if (FAILED(result))
+    result = token->GetStringValue(nullptr, description);
+  return result;
+}
+
+bool PrismGetVoiceName(ISpObjectToken* token, std::string* name) {
+  base::win::ScopedCoMem<WCHAR> description;
+  if (SUCCEEDED(PrismSpGetDescription(token, &description)) && description) {
+    *name = base::WideToUTF8(description.get());
+    if (!name->empty())
+      return true;
+  }
+
+  // Some OneCore tokens do not expose a localized description through SAPI.
+  // Their token id is still stable and selects the same native voice.
+  base::win::ScopedCoMem<WCHAR> token_id;
+  if (FAILED(token->GetId(&token_id)) || !token_id)
+    return false;
+  std::wstring value(token_id.get());
+  size_t separator = value.find_last_of(L"\\/");
+  if (separator != std::wstring::npos)
+    value = value.substr(separator + 1);
+  *name = base::WideToUTF8(value);
+  return !name->empty();
+}
 
+scoped_refptr<base::SequencedTaskRunner> StartPrismTtsWorkerThread(
+    base::Thread* thread) {
+  // SAPI objects and their tokens must be created and consumed from an
+  // explicitly initialized COM apartment. A dedicated MTA also prevents a
+  // SequenceBound worker from migrating to a non-COM ThreadPool worker.
+  thread->init_com_with_mta(true);
+  CHECK(thread->Start());
+  return thread->task_runner();
+}
