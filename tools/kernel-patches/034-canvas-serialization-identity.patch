+void ImageDataBuffer::ApplyPrismCanvasSerializationIdentity() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  const std::string render_identity = command_line->GetSwitchValueASCII(
+      switches::kFingerprintRenderIdentity);
+  if ((render_identity != "v3" && render_identity != "v4") ||
+      (command_line->HasSwitch(switches::kDisableSpoofing) &&
+       command_line->GetSwitchValueASCII(switches::kDisableSpoofing)
+               .find("canvas") != std::string::npos)) {
+    return;
+  }
+
+  uint32_t fingerprint = 0;
+  if (!base::StringToUint(
+          command_line->GetSwitchValueASCII(switches::kFingerprint),
+          &fingerprint) ||
+      pixmap_.width() < 2 || pixmap_.height() < 2 ||
+      (pixmap_.colorType() != kRGBA_8888_SkColorType &&
+       pixmap_.colorType() != kBGRA_8888_SkColorType)) {
+    return;
+  }
+
+  const size_t byte_size = pixmap_.computeByteSize();
+  sk_sp<SkData> data = SkData::MakeUninitialized(byte_size);
+  std::memcpy(data->writable_data(), pixmap_.addr(), byte_size);
+  SkPixmap owned_pixmap(pixmap_.info(), data->writable_data(),
+                        pixmap_.rowBytes());
+
+  // Encode all 32 seed bits into RGB least-significant bits of the first
+  // opaque pixels. Distinct profile seeds therefore cannot collapse to the
+  // same serialized 2D canvas merely because a small text offset collided.
+  uint32_t bit = 0;
+  for (int y = 0; y < owned_pixmap.height() && bit < 32; ++y) {
+    for (int x = 0; x < owned_pixmap.width() && bit < 32; ++x) {
+      auto* pixel = static_cast<uint8_t*>(owned_pixmap.writable_addr(x, y));
+      if (!pixel || pixel[3] == 0) {
+        continue;
+      }
+      for (int channel = 0; channel < 3 && bit < 32; ++channel, ++bit) {
+        pixel[channel] = static_cast<uint8_t>(
+            (pixel[channel] & 0xfeu) | ((fingerprint >> bit) & 1u));
+      }
+    }
+  }
+  if (bit != 32) {
+    return;
+  }
+
+  retained_image_ = SkImages::RasterFromData(
+      owned_pixmap.info(), std::move(data), owned_pixmap.rowBytes());
+  if (retained_image_) {
+    retained_image_->peekPixels(&pixmap_);
+  }
+}
