 void SetPrismProfileOverlay(HWND hwnd, const std::string& serial) {
+  if (!IsWindow(hwnd)) {
+    return;
+  }
   ITaskbarList3* taskbar = nullptr;
   if (FAILED(CoCreateInstance(CLSID_TaskbarList, nullptr, CLSCTX_INPROC_SERVER,
                               IID_PPV_ARGS(&taskbar)))) {
@@ -124,6 +129,26 @@
   taskbar->Release();
 }
 
+void SchedulePrismProfileOverlay(HWND hwnd, const std::string& serial) {
+  // Windows creates the taskbar button asynchronously. SetOverlayIcon called
+  // only during HWND property initialization can succeed before that button
+  // exists and then be silently discarded. Apply immediately and retry after
+  // the shell has had time to register the button.
+  SetPrismProfileOverlay(hwnd, serial);
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&SetPrismProfileOverlay, hwnd, serial),
+      base::Milliseconds(300));
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&SetPrismProfileOverlay, hwnd, serial),
+      base::Milliseconds(1200));
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&SetPrismProfileOverlay, hwnd, serial),
+      base::Seconds(3));
+}
