+scoped_refptr<StaticBitmapImage> ApplyRenderIdentityToWebGLSnapshot(
+    scoped_refptr<StaticBitmapImage> snapshot) {
+  if (!snapshot) {
+    return nullptr;
+  }
+  sk_sp<SkImage> source =
+      snapshot->PaintImageForCurrentFrame().GetSwSkImage();
+  if (!source || source->imageInfo().bytesPerPixel() != 4u) {
+    return snapshot;
+  }
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocPixels(source->imageInfo()) ||
+      !source->readPixels(bitmap.pixmap(), 0, 0)) {
+    return snapshot;
+  }
+  ApplyRenderIdentityToWebGLPixels(
+      bitmap.getPixels(), bitmap.width(), bitmap.height(), bitmap.rowBytes(),
+      4u, 0, 0, bitmap.width(), bitmap.height(), true);
+  scoped_refptr<StaticBitmapImage> result =
+      UnacceleratedStaticBitmapImage::Create(
+          SkImages::RasterFromBitmap(bitmap), snapshot->Orientation());
+  if (!result) {
+    return snapshot;
   }
+  result->SetOriginClean(snapshot->OriginClean());
+  result->SetHighEntropyCanvasOpTypes(snapshot->HighEntropyCanvasOpTypes());
+  return result;
 }
 
