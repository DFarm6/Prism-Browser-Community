+std::optional<std::string> GetPrismSwitchValue(const char* name,
+                                                size_t maximum_length,
+                                                bool decimal_only) {
+  const std::string value =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(name);
+  if (value.empty() || value.size() > maximum_length) {
+    return std::nullopt;
+  }
+  for (char character : value) {
+    const bool valid = decimal_only
+                           ? character >= '0' && character <= '9'
+                           : (character >= 'a' && character <= 'z') ||
+                                 (character >= 'A' && character <= 'Z') ||
+                                 (character >= '0' && character <= '9') ||
+                                 character == '-';
+    if (!valid) {
+      return std::nullopt;
+    }
+  }
+  return value;
+}
+
+HICON CreatePrismProfileOverlay(const std::wstring& serial) {
+  constexpr int kIconSize = 32;
+  BITMAPINFO bitmap_info = {};
+  bitmap_info.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+  bitmap_info.bmiHeader.biWidth = kIconSize;
+  bitmap_info.bmiHeader.biHeight = -kIconSize;
+  bitmap_info.bmiHeader.biPlanes = 1;
+  bitmap_info.bmiHeader.biBitCount = 32;
+  bitmap_info.bmiHeader.biCompression = BI_RGB;
+  void* pixels = nullptr;
+  HBITMAP color_bitmap =
+      CreateDIBSection(nullptr, &bitmap_info, DIB_RGB_COLORS, &pixels, nullptr,
+                       0);
+  if (!color_bitmap || !pixels) {
+    return nullptr;
+  }
+  const BYTE mask_bits[kIconSize * kIconSize / 8] = {};
+  HBITMAP mask_bitmap =
+      CreateBitmap(kIconSize, kIconSize, 1, 1, mask_bits);
+  HDC drawing_context = CreateCompatibleDC(nullptr);
+  HGDIOBJ previous_bitmap = SelectObject(drawing_context, color_bitmap);
+  RECT bounds = {0, 0, kIconSize, kIconSize};
+  HBRUSH background = CreateSolidBrush(RGB(230, 126, 34));
+  FillRect(drawing_context, &bounds, background);
+  DeleteObject(background);
+  SetBkMode(drawing_context, TRANSPARENT);
+  SetTextColor(drawing_context, RGB(255, 255, 255));
+  const int font_height = serial.size() <= 3 ? 18 : serial.size() <= 5 ? 14 : 11;
+  HFONT font = CreateFontW(-font_height, 0, 0, 0, FW_BOLD, FALSE, FALSE, FALSE,
+                           DEFAULT_CHARSET, OUT_DEFAULT_PRECIS,
+                           CLIP_DEFAULT_PRECIS, CLEARTYPE_QUALITY,
+                           DEFAULT_PITCH | FF_SWISS, L"Segoe UI");
+  HGDIOBJ previous_font = SelectObject(drawing_context, font);
+  DrawTextW(drawing_context, serial.c_str(), static_cast<int>(serial.size()),
+            &bounds, DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX);
+  auto* pixel_values = static_cast<DWORD*>(pixels);
+  for (int index = 0; index < kIconSize * kIconSize; ++index) {
+    pixel_values[index] |= 0xff000000;
+  }
+  SelectObject(drawing_context, previous_font);
+  SelectObject(drawing_context, previous_bitmap);
+  DeleteObject(font);
+  DeleteDC(drawing_context);
+  ICONINFO icon_info = {};
+  icon_info.fIcon = TRUE;
+  icon_info.hbmMask = mask_bitmap;
+  icon_info.hbmColor = color_bitmap;
+  HICON icon = CreateIconIndirect(&icon_info);
+  DeleteObject(mask_bitmap);
+  DeleteObject(color_bitmap);
+  return icon;
+}
+
+void SetPrismProfileOverlay(HWND hwnd, const std::string& serial) {
+  ITaskbarList3* taskbar = nullptr;
+  if (FAILED(CoCreateInstance(CLSID_TaskbarList, nullptr, CLSCTX_INPROC_SERVER,
+                              IID_PPV_ARGS(&taskbar)))) {
+    return;
+  }
+  if (SUCCEEDED(taskbar->HrInit())) {
+    HICON icon = CreatePrismProfileOverlay(base::UTF8ToWide(serial));
+    if (icon) {
+      taskbar->SetOverlayIcon(hwnd, icon, base::UTF8ToWide(serial).c_str());
+      DestroyIcon(icon);
+    }
+  }
+  taskbar->Release();
+}
